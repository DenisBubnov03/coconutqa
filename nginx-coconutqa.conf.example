# Статический лендинг coconutqa.ru (отдельно от LMS coconutschool.ru)
# Скопировать на ВМ: /etc/nginx/sites-available/coconutqa
# ln -sf /etc/nginx/sites-available/coconutqa /etc/nginx/sites-enabled/
# nginx -t && systemctl reload nginx
#
# http и www всегда уходят на https://coconutqa.ru
# Несуществующий адрес отдаёт 404, а не копию главной.
# Пути сертификатов — стандартные для certbot. Если nginx -t ругается на ssl,
# оставьте ssl_certificate из уже рабочего файла.

server {
    listen 80;
    server_name coconutqa.ru www.coconutqa.ru;
    return 301 https://coconutqa.ru$request_uri;
}

server {
    listen 443 ssl;
    server_name www.coconutqa.ru;

    ssl_certificate /etc/letsencrypt/live/coconutqa.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coconutqa.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://coconutqa.ru$request_uri;
}

server {
    listen 443 ssl;
    server_name coconutqa.ru;

    ssl_certificate /etc/letsencrypt/live/coconutqa.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coconutqa.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/coconutqa;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml;

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location /index_files/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location = /privacy.html {
        return 301 /privacy;
    }

    location = /privacy {
        try_files /privacy.html =404;
    }

    location = /privacy/ {
        return 301 /privacy;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
